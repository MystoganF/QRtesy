# Frontend (qrtesy-web)
VITE_API_BASE_URL=

# Backend Database (Supabase Session Pooler - Port 5432)
DB_URL=jdbc:postgresql:project-url
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-db-password

# Staff Auth, Public Links & CORS (qrtesy-backend)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
APP_PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Email Confirmation Sandbox (Resend Test Mode)
MAIL_ENABLED=true
RESEND_API_KEY=re_replace_with_your_resend_sandbox_api_key
MAIL_FROM=QRtesy <onboarding@resend.dev>

# Seeded Demo Staff Credentials (change in production)
SEED_STAFF_NAME=Event Organizer
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD=ChangeMe123!
SEED_DOOR_NAME=Door Check-in Staff
SEED_DOOR_USERNAME=door
